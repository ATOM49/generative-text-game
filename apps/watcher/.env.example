# Server-side provider credentials. Never expose these through NEXT_PUBLIC_*.
# The recommended mixed workflow needs both keys. For an OpenAI-only setup,
# leave SEGMIND_API_KEY empty and set AI_IMAGE_PROVIDER=openai.
SEGMIND_API_KEY=

# Image generation switches to Segmind automatically when SEGMIND_API_KEY is
# present. Set explicitly to make the deployment intent unambiguous.
AI_IMAGE_PROVIDER=segmind
SEGMIND_MAP_MODEL=nano-banana-pro
SEGMIND_CHARACTER_MODEL=seedream-4.5
SEGMIND_FACTION_MODEL=ideogram-4

# Structured text and inpainting remain independently selectable. Keep these
# on OpenAI until Segmind model-specific adapters are configured for them.
AI_TEXT_PROVIDER=openai
AI_IMAGE_EDIT_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_IMAGE_EDIT_MODEL=dall-e-2

# Local MinIO defaults are documented in packages/cdn. Override as needed.
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=images
MINIO_PUBLIC_HOST=http://localhost:9000
