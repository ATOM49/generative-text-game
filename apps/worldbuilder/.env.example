# MongoDB runs through the root Docker Compose stack.
DATABASE_URL="mongodb://localhost:27017/talespin?replicaSet=rs0"

# Server-side connection to apps/watcher.
WATCHER_API_URL="http://localhost:4000"
WATCHER_GENERATION_TIMEOUT_MS="300000"

# Local Auth.js / NextAuth configuration.
NEXTAUTH_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# Development-only credentials account. Disable and configure both OAuth
# providers for production-like authentication.
E2E_TEST_MODE="true"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# Optional unless exercising CopilotKit-assisted UI.
NEXT_PUBLIC_COPILOT_CLOUD_PUBLIC_API_KEY=""
